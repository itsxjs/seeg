# --- TRACKED BY GIT LFS ---
# Allow these extensions for LFS up to 2GB
# .mat, .bin, .npy, .spk, .zip are handled by LFS in .gitattributes

# --- STRICTLY IGNORED (FILES > 2GB OR RAW DATA) ---
# GitHub LFS free/standard tier limits single files to 2GB.
# We must ignore these extremely large raw/concatenated files.
*.raw
*concatenated_raw_data.bin
*concatenated_data_for_ks.bin
*.spk
*.spkidx

# Specific large .mat files found in search
ZE-EPI-VE-20241202-1330.mat

# Kilosort/Phy specific
kilosort4/
phy_env/
phy_env312/
rez.mat

# System
System Volume Information/
.Trash/
$RECYCLE.BIN/
